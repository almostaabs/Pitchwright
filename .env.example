# Copy to .env and fill in. No real values belong in this file.

# --- LLM provider ---
# "ollama" (default): local models, no API key, nothing leaves the machine.
# "anthropic": fallback, needs ANTHROPIC_API_KEY below.
LLM_PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
# Must be a model you have actually pulled. Check with: ollama list
# Leave blank to use whatever Ollama reports first from /api/tags.
OLLAMA_DRAFT_MODEL=
# Defaults to OLLAMA_DRAFT_MODEL when blank. A larger, slower model here is a
# reasonable trade: validation is the only thing standing between a fabricated
# statistic and a sent email, and it runs once per draft. Losing Claude as the
# judge costs real rigour - a bigger local judge buys part of it back.
OLLAMA_VALIDATE_MODEL=

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Paths (all optional - these are the defaults)
WORKBOOK_PATH=data/outreach.xlsx
INPUT_FILE=data/prospects_input.csv
FACT_SHEET_PATH=config/fact_sheet.json
GMAIL_CREDENTIALS=config/credentials.json
GMAIL_TOKEN=config/token.json

# Guardrails
SEND_CAP=25
MAX_VALIDATION_RETRIES=2
FOLLOWUP_DAYS=5

# Set true to run the whole pipeline without actually calling Gmail send.
DRY_RUN=false
